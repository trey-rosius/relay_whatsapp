        <mxCell id="col1_hdr" value="&lt;b&gt;1. Invocations &amp;amp; Execution Context&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;fontColor=#38bdf8;fontSize=15;align=center;fontStyle=1;" vertex="1" parent="1">
