# AWS Strands Decider 2B Container for AWS Fargate & ECS Deployment
# Optimized for ARM64 Graviton / x86_64 CPU inference
FROM python:3.11-slim

LABEL maintainer="AWS Strands Marketplace Team"
LABEL description="Self-hosted AWS Strands Decider 2B System 1 Microservice on AWS Fargate"

# Set non-interactive environment
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install basic networking and runtime utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install PyTorch CPU/ARM64 and official strands-decider server package
RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir strands-decider

# Standard Decider Configuration
ENV PORT=8000
ENV HOST=0.0.0.0
ENV MODEL=StrandsAgents/strands-decider-2B-hobson-v19

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD curl -f http://localhost:8000/v1/systemone || exit 0

# Launch Strands Decider server
CMD ["sh", "-c", "strands-decider serve ${MODEL} --port ${PORT} --host ${HOST}"]
