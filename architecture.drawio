        <mxCell id="lbl-bedrock" value="&lt;b style=&quot;font-size: 14px; color: #c084fc;&quot;&gt;Amazon Bedrock Multimodal &amp;amp; Dual-Intent NLP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;• Text &amp;amp; Image Extraction (Amazon Bedrock Nova Lite &amp;amp; Claude)&lt;br&gt;• Compound Dual-Intent Parser: Simultaneous Buyer + Seller&lt;br&gt;• Multi-Book Curriculum Batch Expander: Multi-line vertical parsing&lt;br&gt;• Automatic Book Condition Grading: New, Good, Acceptable&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1090" y="415" width="375" height="95" as="geometry" />
        </mxCell>

        <!-- Node 3.4: Greeting Filter -->
        <mxCell id="c3-greeting-filter" value="&lt;b style=&quot;font-size: 14px; color: #67e8f9;&quot;&gt;Intelligent Greeting Filter &amp;amp; Inquiry Auto-Promoter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;• Context-Aware Message De-Noiser (intentsTolerate)&lt;br&gt;• Strips greeting noise (&#39;Hello everyone! Please...&#39;) when actionable intents exist&lt;br&gt;• Auto-promotes grade-specific inquiries into active transactions&lt;br&gt;• Triggers conversational grade clarification prompts if school year missing&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#164e63;strokeColor=#06b6d4;strokeWidth=2;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="1015" y="530" width="460" height="95" as="geometry" />
        </mxCell>

        <!-- Node 3.5: Catalog Normalizer -->
        <mxCell id="c3-catalog-norm" value="&lt;b style=&quot;font-size: 14px; color: #34d399;&quot;&gt;Declarative SUBJECT_CATALOG Normalizer &amp;amp; Translator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;• 4-Stage Declarative Regex Pipeline with Word Boundaries (\b)&lt;br&gt;• CamelCase splitting (Year5Chemistry -&amp;gt; Year 5 Chemistry)&lt;br&gt;• Canonical bilingual dictionary: Mathematics == Mathématiques, SVT == Biologie&lt;br&gt;• Produces clean SubjectName &amp;amp; NormalizedConceptKey&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="1015" y="640" width="460" height="95" as="geometry" />
        </mxCell>

        <!-- Node 3.6: Matchmaker -->
        <mxCell id="c3-matchmaker" value="&lt;b style=&quot;font-size: 14px; color: #facc15;&quot;&gt;Proactive Matchmaking &amp;amp; 48H Reservation Lock (#XXXX)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;• Dual-Track GSI byConcept Lookup + Asymmetric Intro Generator&lt;br&gt;• Issues Cryptographic 4-Digit Handover Verification Code (#XXXX)&lt;br&gt;• Sets status: &#39;reserved&#39; with reservedUntil = Date.now() + 48 Hours&lt;br&gt;• Introduces buyer &amp;amp; seller in respective languages without phone leaks&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#713f12;strokeColor=#eab308;strokeWidth=2;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="1015" y="750" width="460" height="100" as="geometry" />
        </mxCell>

        <!-- Node 3.7: Handover Settlement -->
