          <mxGeometry x="205" y="30" width="160" height="55" as="geometry" />
        </mxCell>

        <mxCell id="t_create_demand" value="➕ createDemand&#xa;Register wishlist item" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D9488;strokeColor=#14B8A6;fontColor=#FFFFFF;fontStyle=1;align=center;fontSize=11;" vertex="1" parent="tools_box">
          <mxGeometry x="390" y="30" width="160" height="55" as="geometry" />
        </mxCell>

        <mxCell id="t_register_offer" value="📚 registerBookOffer&#xa;Add active book listing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803D;strokeColor=#22C55E;fontColor=#FFFFFF;fontStyle=1;align=center;fontSize=11;" vertex="1" parent="tools_box">
          <mxGeometry x="575" y="30" width="165" height="55" as="geometry" />
        </mxCell>

        <mxCell id="t_storefront" value="👨‍👩‍👧 getSellerCatalog&#xa;Family bundle summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6D28D9;strokeColor=#A78BFA;fontColor=#FFFFFF;fontStyle=1;align=center;fontSize=11;" vertex="1" parent="tools_box">
          <mxGeometry x="110" y="105" width="250" height="55" as="geometry" />
        </mxCell>

        <mxCell id="t_deficits" value="📢 getSupplyDeficits&#xa;Community shortfall broadcast" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B91C1C;strokeColor=#F87171;fontColor=#FFFFFF;fontStyle=1;align=center;fontSize=11;" vertex="1" parent="tools_box">
          <mxGeometry x="400" y="105" width="250" height="55" as="geometry" />
        </mxCell>

        <!-- Pipeline Engines -->
        <mxCell id="sandbox_orchestrator" value="Developer Sandbox Controller &amp; Mock Seeder&#xa;🧪 #SANDBOX, #SEED, #RESET, #STATUS Fast-Path Router&#xa;• #SEED: 15 Cameroon textbooks across Primary, Middle &amp; High School&#xa;• 1 Active 48H Reserved Hold with Parent Marie (+237 670 000 001) [Code: #7721]&#xa;• 1 Open Wishlist Demand (Terminale C Physique from Parent Paul)&#xa;• #RESET: Atomic wipe of all simulated records leaving real community data 100% intact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_agent">
          <mxGeometry x="30" y="350" width="760" height="110" as="geometry" />
        </mxCell>

        <mxCell id="bedrock_multimodal" value="Amazon Bedrock Multimodal &amp; 11-Intent NLP Engine&#xa;🧠 Text &amp; Image Feature Extraction (Amazon Bedrock Nova Lite &amp; Claude)&#xa;• 11 Intent Taxonomy: offer, demand, offer_inquiry, demand_inquiry, catalog, demand_board,&#xa;  greeting, confirm_handover, parent_activity, contact_inquiry, other_grades&#xa;• Typo-Tolerant Stem Scoring: normalizeTextForMatching handles misspellings ('mes livr', 'donne num')&#xa;• Phone Unmasking Guarantee: ensureUnredactedMessage provides real contact info on matched inquiries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4338CA;strokeColor=#818CF8;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_agent">
          <mxGeometry x="30" y="480" width="760" height="110" as="geometry" />
        </mxCell>

        <mxCell id="parent_activity_engine" value="Parent Activity &amp; Transaction History Aggregator&#xa;📊 buildParentActivitySummary(phone, lang, isSandbox)&#xa;• Scans active-inventory &amp; demand-board for caller phone&#xa;• Structured Breakdown: 📖 Added, ⏳ Reserved (#XXXX), 🤝 Sold, 🎓 Bought, 📋 Demanded&#xa;• Fully localized in English and French with zero-latency fast-paths" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_agent">
          <mxGeometry x="30" y="610" width="760" height="95" as="geometry" />
        </mxCell>

        <mxCell id="intent_filter" value="Intelligent Greeting Filter &amp; Inquiry Auto-Promoter&#xa;🔇 Context-Aware Message De-Noiser (intentsToIterate)&#xa;• Strips greeting noise ('Hello everyone! Please...') when actionable intents exist&#xa;• Auto-promotes grade-specific inquiries (demand_inquiry / offer_inquiry) into active transactions&#xa;• Triggers conversational grade clarification prompts if school year is missing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4F46E5;strokeColor=#6366F1;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_agent">
          <mxGeometry x="30" y="725" width="760" height="85" as="geometry" />
        </mxCell>

        <mxCell id="subject_catalog" value="Declarative SUBJECT_CATALOG Normalizer &amp; Translator&#xa;📖 4-Stage Declarative Regex Pipeline with Word Boundaries (\b)&#xa;• CamelCase splitting (Year5Chemistry ➔ Year 5 Chemistry) + Boilerplate stripping&#xa;• Canonical bilingual dictionary: Mathematics ⇄ Mathématiques, Biology ⇄ Biologie/SVT&#xa;• Single Source of Truth shared across cleanSubjectName and normalizeConceptKey" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_agent">
          <mxGeometry x="30" y="830" width="760" height="85" as="geometry" />
        </mxCell>

        <mxCell id="matchmaker_engine" value="Proactive Matchmaking &amp; 48H Reservation Lock (#XXXX)&#xa;🎯 Dual-Track GSI byConcept Lookup + Asymmetric Intro Generator&#xa;• Issues Cryptographic 4-Digit Handover Verification Code (#XXXX)&#xa;• Sets status: 'reserved' with reservedUntil = Date.now() + 48 Hours&#xa;• Introduces buyer &amp; seller in their respective languages without exposing public phone numbers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D9488;strokeColor=#14B8A6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_agent">
          <mxGeometry x="30" y="935" width="760" height="95" as="geometry" />
        </mxCell>

        <mxCell id="handover_settlement" value="Handover Settlement &amp; Completion Engine&#xa;🤝 Natural Language Settlement Trigger ('Sold', 'Vendu', 'Remis', 'Got it')&#xa;• Automatically transitions active-inventory to status: 'sold' (soldAt, soldToPhone)&#xa;• Automatically transitions demand-board wishlist to status: 'fulfilled'&#xa;• Dispatches celebratory bilingual completion messages to both participating parents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#10B981;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_agent">
          <mxGeometry x="30" y="1050" width="760" height="80" as="geometry" />
        </mxCell>

        <mxCell id="cron_sweeper" value="AWS EventBridge Scheduler: holdExpiryCron&#xa;⏰ @aws-blocks/bb-cron-job running rate(15 minutes)&#xa;• Proactively sweeps DynamoDB for expired holds (reservedUntil &lt; now)&#xa;• Resets expired books to status: 'active' &amp; demands to status: 'pending'&#xa;• Prevents inventory lockup and emits HoldExpired lifecycle CloudWatch events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C2410C;strokeColor=#FB923C;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_agent">
          <mxGeometry x="30" y="1150" width="760" height="80" as="geometry" />
        </mxCell>

        <mxCell id="interactive_engine" value="Meta Interactive 2-Tier List &amp; Safety Sub-Drawers&#xa;📱 WhatsApp UX Optimization with 10-Row Limit Bypass&#xa;• Tier 1: Primary Grade summary drawer ([ 📚 Select Grade ])&#xa;• Dedicated 'Other Grades' Sub-Drawer (buildInteractiveOtherGradesPayload) for Year 11-13 &amp; General&#xa;• Tier 2: Subject drill-down drawer ([ 📖 Select Book ]) with condition badges&#xa;• Safety Card: 2-Button confirmation ([ ✅ Confirm Request ] / [ ❌ Cancel ])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_agent">
          <mxGeometry x="30" y="1250" width="760" height="100" as="geometry" />
        </mxCell>

        <mxCell id="outbound_dispatcher" value="WhatsApp Outbound Dispatcher &amp; Mock Interceptor&#xa;📤 sendWhatsAppTextMessage() &amp; dispatchTextMessage()&#xa;• Mock Recipient Safeguard: Intercepts mock numbers (+237670000001, +237690000002)&#xa;• Meta Graph API v25.0 Dispatcher with Exponential Backoff&#xa;• Automatic 🧪 [SANDBOX MODE] message prefixing for developer sessions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#3B82F6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_agent">
          <mxGeometry x="30" y="1370" width="760" height="85" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- 4. PERSISTENCE, VECTORS & OBSERVABILITY                          -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <mxCell id="layer_storage" value="4. Persistence, Vectors &amp; Enterprise Telemetry" style="swimlane;whiteSpace=wrap;html=1;fillColor=#064E3B;strokeColor=#34D399;fontColor=#A7F3D0;fontStyle=1;rounded=1;arcSize=8;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1820" y="100" width="540" height="1480" as="geometry" />
        </mxCell>

        <mxCell id="dynamo_inventory" value="Amazon DynamoDB: active-inventory&#xa;📊 PK: itemId (UUID)&#xa;🔍 GSI: byConcept (concept PK, createdAt SK)&#xa;• Attributes: title, subject, grade, condition, status (active|reserved|sold)&#xa;• 48H Hold: reservedUntil, reservedForPhone, handoverCode, matchedDemandId&#xa;• Developer Sandbox: isSimulated: boolean (100% data shielded from production)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E40AF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_storage">
          <mxGeometry x="25" y="40" width="490" height="115" as="geometry" />
        </mxCell>

        <mxCell id="dynamo_demand" value="Amazon DynamoDB: demand-board&#xa;📋 PK: demandId (UUID)&#xa;🔍 GSI: byConcept (concept PK, createdAt SK)&#xa;• Attributes: userPhone, requestedQuery, concept, domain, status (pending|matched|fulfilled)&#xa;• Handover: matchedItemId, handoverCode, matchedAt&#xa;• Developer Sandbox: isSimulated: boolean (100% data shielded from production)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E7490;strokeColor=#06B6D4;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_storage">
          <mxGeometry x="25" y="175" width="490" height="115" as="geometry" />
        </mxCell>

        <mxCell id="dynamo_sandbox" value="Amazon DynamoDB: sandbox-sessions&#xa;🧪 KVStore: phone (PK) ➔ { active: boolean, activatedAt: number }&#xa;• Sub-10ms developer session state lookup&#xa;• In-Memory Map fallback cache for instant response&#xa;• Dynamic isolation router for in-chat developer testing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#14B8A6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_storage">
          <mxGeometry x="25" y="310" width="490" height="100" as="geometry" />
        </mxCell>

        <mxCell id="s3_images" value="Amazon S3 FileBucket: parent-book-images&#xa;🖼️ Uploaded Book Cover Photos&#xa;• Prefix: processed/&#xa;• ⏳ Automated 30-Day Data Lifecycle Expiration Policy&#xa;• Encrypted with AWS KMS Customer Managed Key (CMK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803D;strokeColor=#22C55E;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_storage">
          <mxGeometry x="25" y="430" width="490" height="95" as="geometry" />
        </mxCell>

        <mxCell id="bedrock_kb" value="Amazon Bedrock KnowledgeBase &amp; S3 Vectors&#xa;🧠 Semantic Marketplace &amp; Curriculum Vector Embeddings&#xa;• Titan Embeddings G1 - Text&#xa;• Strict 2048-Byte (2KB) Vector Chunking Enforcement&#xa;• Fast Similarity Search for Non-Standard Book Queries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6D28D9;strokeColor=#A78BFA;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_storage">
          <mxGeometry x="25" y="545" width="490" height="100" as="geometry" />
        </mxCell>

        <mxCell id="eventbridge_bus" value="Amazon EventBridge Lifecycle Events&#xa;📡 Real-Time Lifecycle Event Stream&#xa;• Event Types: ProcessingStarted, ExtractionComplete, MatchFound,&#xa;  InventoryAdded, S3VectorIngested, HandoverConfirmed, HoldExpired" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C2410C;strokeColor=#FB923C;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_storage">
          <mxGeometry x="25" y="665" width="490" height="95" as="geometry" />
        </mxCell>

        <mxCell id="cloudwatch_emf" value="Amazon CloudWatch Embedded Metric Format (EMF)&#xa;📈 Namespace: BooksApp/WhatsAppMarketplace&#xa;• Custom Metrics: ProcessingLatency, BedrockDuration, MatchFoundCount,&#xa;  HoldExpiredCount, HandoverConfirmedCount, DeliveryFailures&#xa;• Proactive Alarms for ThrottlingErrors &amp; Meta Delivery Drops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BE123C;strokeColor=#F43F5E;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_storage">
          <mxGeometry x="25" y="780" width="490" height="105" as="geometry" />
        </mxCell>

        <mxCell id="xray_traces" value="AWS X-Ray Distributed Tracing&#xa;🔍 Tracer spans across all message lifecycle stages&#xa;• Segments: webhook_ingress, pii_sanitization, bedrock_parse,&#xa;  matchmaker_query, dynamodb_put, whatsapp_dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#94A3B8;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_storage">
          <mxGeometry x="25" y="905" width="490" height="95" as="geometry" />
        </mxCell>

