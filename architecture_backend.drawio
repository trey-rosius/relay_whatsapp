        <mxCell id="strands_core" value="Strands Agent Core (booksAgent)&#xa;🤖 @aws-blocks/bb-agent with Strands Agents SDK&#xa;• Model-Driven Multi-Turn Autonomous Reasoning Loop&#xa;• BedrockModels.BALANCED (Anthropic Claude 3.5 / 3.7 Sonnet)&#xa;• System Prompt Invariants &amp; Cryptographic SHA-256 Anti-Drift Checksums" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E40AF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_agent">
