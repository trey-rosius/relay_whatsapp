        <mxCell id="flow_4" value="4. Verify HMAC-SHA256" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38BDF8;strokeWidth=2;fontColor=#38BDF8;" edge="1" parent="1" source="api_gw_webhook" target="sig_validator">
