        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- HEADER / TITLE BANNER                                              -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <mxCell id="title_banner" value="RELAY 📚 — Autonomous Parent School Textbook Marketplace &amp; Matchmaker&#xa;End-to-End Enterprise Architecture • Powered by Strands Agents SDK, Amazon Bedrock (Nova Lite &amp; Claude), In-Chat Developer Sandbox &amp; AWS Blocks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#38BDF8;strokeWidth=2;fontColor=#F8FAFC;fontStyle=1;fontSize=17;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="60" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- 1. EXTERNAL CLIENTS & INGRESS LAYER                                -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <mxCell id="layer_clients" value="1. Client &amp; Community Ingress Layer" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;fontColor=#F8FAFC;fontStyle=1;rounded=1;arcSize=8;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="420" height="1480" as="geometry" />
        </mxCell>

        <mxCell id="parent_user" value="Parent School Community&#xa;📱 WhatsApp Mobile App (+237 / +33 / Int'l)&#xa;• Natural Language Chat in English &amp; French&#xa;• Compound Dual-Intent ('Looking for Y6 &amp; Have Y5')&#xa;• Multi-Book Curriculum Batch Listings (Y10 &amp; Y11)&#xa;• Inbound Textbook Cover Photo Uploads&#xa;• 2-Tier Interactive List Browsing &amp; 2-Button Cards&#xa;• Handover Confirmations ('Sold' / 'Vendu' / 'Got it')&#xa;• Parent Activity Tracking ('my books' / 'mes livres')&#xa;• Overflow Grade Browsing ('other grades' / 'autres classes')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#10B981;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_clients">
          <mxGeometry x="30" y="40" width="360" height="180" as="geometry" />
        </mxCell>

        <mxCell id="meta_cloud" value="Meta WhatsApp Cloud API (v25.0)&#xa;⚡ https://graph.facebook.com/v25.0/&#xa;• HMAC-SHA256 Signed Webhook Dispatch&#xa;• Sub-3s Ingress Response SLA&#xa;• Interactive List Messages (Tier 1 &amp; Tier 2)&#xa;• 2-Button Action Confirmation Cards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#3B82F6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_clients">
          <mxGeometry x="30" y="240" width="360" height="110" as="geometry" />
        </mxCell>

        <mxCell id="dev_sandbox_tester" value="Bot Creator &amp; Developer Channel&#xa;🧪 In-Chat Developer Sandbox Mode&#xa;• #SANDBOX ON : Activate isolated testing session&#xa;• #SEED : 15 Cameroon mock textbooks + 1 hold + 1 demand&#xa;• #STATUS : Inspect simulated inventory counts&#xa;• #RESET : Atomic wipe of all simulated records&#xa;• #SANDBOX OFF : Return to live production mode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E7490;strokeColor=#06B6D4;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_clients">
          <mxGeometry x="30" y="370" width="360" height="135" as="geometry" />
        </mxCell>

        <mxCell id="web_frontend" value="Admin &amp; Parent Web Application&#xa;🌐 Amazon CloudFront CDN + S3 Static Hosting&#xa;• Lit-HTML &amp; Vite Reactive Single Page App&#xa;• Real-time Inventory &amp; Wishlist Radar&#xa;• Family Storefronts &amp; Grade Bundles (3A)&#xa;• Supply Deficit Broadcast Campaigns (3B)&#xa;• Manual 48H Hold Sweeper &amp; Sandbox Controls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_clients">
          <mxGeometry x="30" y="525" width="360" height="135" as="geometry" />
        </mxCell>

        <mxCell id="realtime_ws" value="WebSocket Realtime Streaming&#xa;⚡ wss://ftuliydf8c.execute-api.us-east-1.../rt&#xa;• Powered by @aws-blocks/bb-realtime&#xa;• Live LLM Token &amp; Block Streaming to Web UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0891B2;strokeColor=#06B6D4;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_clients">
          <mxGeometry x="30" y="680" width="360" height="95" as="geometry" />
        </mxCell>

        <mxCell id="secrets_manager" value="AWS Secrets Manager&#xa;🔑 WhatsApp Token, Phone Number ID, App Secret&#xa;• Dynamic In-Memory TTL Caching (5 Minutes)&#xa;• Zero-Downtime Secret Rotation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#F59E0B;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_clients">
          <mxGeometry x="30" y="800" width="360" height="95" as="geometry" />
