        <mxCell id="parent_user" value="Parent School Community&#xa;📱 WhatsApp Mobile App (+237 / +33 / Int'l)&#xa;• Natural Language Chat in English &amp; French&#xa;• Inbound Textbook Cover Photo Uploads&#xa;• 2-Tier Interactive List Browsing&#xa;• 2-Button Safe Reservation Confirmations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#10B981;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_clients">
