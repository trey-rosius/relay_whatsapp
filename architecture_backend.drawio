        <mxCell id="flow_3" value="3. Rate Limit &amp; IP Check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EF4444;strokeWidth=2;fontColor=#EF4444;" edge="1" parent="1" source="waf_shield" target="api_gw_webhook">
