        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- SYSTEM CONNECTIONS & DATA FLOWS                                  -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <mxCell id="flow_1" value="1. Inbound WhatsApp Msg / Photo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2;fontColor=#10B981;" edge="1" parent="1" source="parent_user" target="meta_cloud">
