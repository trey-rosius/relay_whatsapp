        <mxCell id="tools_box" value="Agent Tool Suite (Zod Validated)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;fontColor=#38BDF8;fontStyle=1;rounded=1;arcSize=6;" vertex="1" parent="layer_agent">
          <mxGeometry x="30" y="150" width="760" height="180" as="geometry" />
