        <mxCell id="flow_6" value="6. Async Event Dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#818CF8;strokeWidth=2;fontColor=#818CF8;" edge="1" parent="1" source="pii_sanitizer" target="strands_core">
          <mxGeometry relative="1" as="geometry" />
