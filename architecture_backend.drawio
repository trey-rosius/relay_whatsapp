        <mxCell id="dynamo_inventory" value="Amazon DynamoDB: active-inventory&#xa;📊 PK: itemId (UUID)&#xa;🔍 GSI: byConcept (concept PK, createdAt SK)&#xa;• Attributes: title, subject, grade, condition, status (active|reserved|sold)&#xa;• 48H Hold: reservedUntil, reservedForPhone, handoverCode, matchedDemandId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E40AF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_storage">
          <mxGeometry x="30" y="50" width="500" height="110" as="geometry" />
        </mxCell>

        <mxCell id="dynamo_demand" value="Amazon DynamoDB: demand-board&#xa;📋 PK: demandId (UUID)&#xa;🔍 GSI: byConcept (concept PK, createdAt SK)&#xa;• Attributes: userPhone, requestedQuery, concept, domain, status (pending|matched|fulfilled)&#xa;• Handover: matchedItemId, handoverCode, matchedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E7490;strokeColor=#06B6D4;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_storage">
          <mxGeometry x="30" y="180" width="500" height="110" as="geometry" />
        </mxCell>

        <mxCell id="s3_images" value="Amazon S3 FileBucket: parent-book-images&#xa;🖼️ Uploaded Book Cover Photos&#xa;• Prefix: processed/&#xa;• ⏳ Automated 30-Day Data Lifecycle Expiration Policy&#xa;• Encrypted with AWS KMS Customer Managed Key (CMK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803D;strokeColor=#22C55E;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_storage">
          <mxGeometry x="30" y="310" width="500" height="100" as="geometry" />
        </mxCell>

        <mxCell id="bedrock_kb" value="Amazon Bedrock KnowledgeBase &amp; S3 Vectors&#xa;🧠 Semantic Marketplace &amp; Curriculum Vector Embeddings&#xa;• Titan Embeddings G1 - Text&#xa;• Strict 2048-Byte (2KB) Vector Chunking Enforcement&#xa;• Fast Similarity Search for Non-Standard Book Queries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6D28D9;strokeColor=#A78BFA;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_storage">
          <mxGeometry x="30" y="430" width="500" height="110" as="geometry" />
        </mxCell>

        <mxCell id="eventbridge_bus" value="Amazon EventBridge Lifecycle Events&#xa;📡 Real-Time Lifecycle Event Stream&#xa;• Event Types: ProcessingStarted, ExtractionComplete, MatchFound,&#xa;  InventoryAdded, S3VectorIngested, HandoverConfirmed, HoldExpired" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C2410C;strokeColor=#FB923C;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_storage">
          <mxGeometry x="30" y="560" width="500" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cloudwatch_emf" value="Amazon CloudWatch Embedded Metric Format (EMF)&#xa;📈 Namespace: BooksApp/WhatsAppMarketplace&#xa;• Custom Metrics: ProcessingLatency, BedrockDuration, MatchFoundCount,&#xa;  HoldExpiredCount, HandoverConfirmedCount, DeliveryFailures&#xa;• Proactive Alarms for ThrottlingErrors &amp; Meta Delivery Drops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BE123C;strokeColor=#F43F5E;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_storage">
          <mxGeometry x="30" y="680" width="500" height="110" as="geometry" />
        </mxCell>

        <mxCell id="xray_traces" value="AWS X-Ray Distributed Tracing&#xa;🔍 Tracer spans across all message lifecycle stages&#xa;• Segments: webhook_ingress, pii_sanitization, bedrock_parse,&#xa;  matchmaker_query, dynamodb_put, whatsapp_dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#94A3B8;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_storage">
          <mxGeometry x="30" y="810" width="500" height="100" as="geometry" />
