        <mxCell id="flow_7" value="7. Multimodal Extraction &amp; Intents" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#818CF8;strokeWidth=2;fontColor=#818CF8;" edge="1" parent="1" source="strands_core" target="bedrock_multimodal">
