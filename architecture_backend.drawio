        <mxCell id="waf_shield" value="AWS WAF v2 Shield&#xa;🛡️ Rate Limiting &amp; IP Reputation Management&#xa;• Anti-DDoS &amp; SQLi / XSS Attack Filtering&#xa;• Strict HTTP Payload Size Verification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#991B1B;strokeColor=#EF4444;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_security">
          <mxGeometry x="30" y="50" width="360" height="100" as="geometry" />
        </mxCell>

        <mxCell id="api_gw_webhook" value="Amazon API Gateway: POST /webhook (RawRoute)&#xa;🚪 Meta Inbound Webhook Ingress&#xa;• Sub-50ms 200 OK Handshake Acknowledgment&#xa;• Non-Blocking Background Queue Transition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0369A1;strokeColor=#38BDF8;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_security">
          <mxGeometry x="30" y="220" width="360" height="100" as="geometry" />
        </mxCell>

        <mxCell id="sig_validator" value="Cryptographic HMAC-SHA256 Verifier&#xa;🔒 crypto.timingSafeEqual(expected, actual)&#xa;• Payload Signature Integrity Verification&#xa;• Replay &amp; Man-in-the-Middle Attack Shield" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#10B981;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_security">
          <mxGeometry x="30" y="360" width="360" height="90" as="geometry" />
        </mxCell>

        <mxCell id="pii_sanitizer" value="Pre-Prompt PII Redactor &amp; Sanitizer&#xa;🛡️ maskPromptPII() Engine&#xa;• International Phone Numbers Redacted ([PHONE_REDACTED])&#xa;• Email Addresses &amp; Physical Home Addresses Stripped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=#F59E0B;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_security">
          <mxGeometry x="30" y="490" width="360" height="90" as="geometry" />
        </mxCell>

        <mxCell id="api_gw_rpc" value="Amazon API Gateway: POST /aws-blocks/api (ApiNamespace)&#xa;🚪 Type-Safe JSON-RPC Namespace&#xa;• chatWithAgent, listInventory, listDemands&#xa;• confirmHandover, releaseExpiredHolds, getSupplyGaps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6D28D9;strokeColor=#A78BFA;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_security">
          <mxGeometry x="30" y="660" width="360" height="100" as="geometry" />
        </mxCell>

        <mxCell id="kms_cmk" value="AWS KMS Customer Managed Key (CMK)&#xa;🔐 alias/books-block-app-cmk&#xa;• Envelope Encryption for DynamoDB &amp; S3 at Rest&#xa;• Dedicated Key Policy &amp; CloudTrail Auditing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#64748B;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_security">
          <mxGeometry x="30" y="1000" width="360" height="100" as="geometry" />
        </mxCell>

