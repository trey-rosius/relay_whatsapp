        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- 2. SECURITY, INGRESS & GOVERNANCE BOUNDARY                       -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <mxCell id="layer_security" value="2. Security, Ingress &amp; Governance Boundary" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1E1B4B;strokeColor=#818CF8;fontColor=#C7D2FE;fontStyle=1;rounded=1;arcSize=8;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="420" height="1480" as="geometry" />
        </mxCell>

        <mxCell id="waf_shield" value="AWS WAF v2 Shield&#xa;🛡️ Rate Limiting &amp; IP Reputation Management&#xa;• Anti-DDoS &amp; SQLi / XSS Attack Filtering&#xa;• Strict HTTP Payload Size Verification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#991B1B;strokeColor=#EF4444;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_security">
          <mxGeometry x="30" y="40" width="360" height="90" as="geometry" />
        </mxCell>

        <mxCell id="api_gw_webhook" value="Amazon API Gateway: POST /webhook (RawRoute)&#xa;🚪 Meta Inbound Webhook Ingress&#xa;• Sub-50ms 200 OK Handshake Acknowledgment&#xa;• Non-Blocking Background Queue Transition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0369A1;strokeColor=#38BDF8;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_security">
          <mxGeometry x="30" y="150" width="360" height="90" as="geometry" />
        </mxCell>

        <mxCell id="sig_validator" value="Cryptographic HMAC-SHA256 Verifier&#xa;🔒 crypto.timingSafeEqual(expected, actual)&#xa;• Payload Signature Integrity Verification&#xa;• Replay &amp; Man-in-the-Middle Attack Shield" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#10B981;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_security">
          <mxGeometry x="30" y="260" width="360" height="80" as="geometry" />
        </mxCell>

        <mxCell id="pii_sanitizer" value="Pre-Prompt PII Redactor &amp; Sanitizer&#xa;🛡️ maskPromptPII() Engine&#xa;• International Phone Numbers Redacted ([PHONE_REDACTED])&#xa;• Email Addresses &amp; Physical Home Addresses Stripped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=#F59E0B;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_security">
          <mxGeometry x="30" y="360" width="360" height="80" as="geometry" />
        </mxCell>

        <mxCell id="sandbox_shield_engine" value="Developer Sandbox Guard &amp; Interceptor&#xa;🛡️ isSandboxSessionActive() &amp; isMockPhoneNumber()&#xa;• 100% Data Shielding: Real parents NEVER see isSimulated items&#xa;• Intercepts outbound dispatches to mock phone numbers&#xa;• Injects 🧪 [SANDBOX MODE] badge into developer messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#14B8A6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_security">
          <mxGeometry x="30" y="460" width="360" height="120" as="geometry" />
        </mxCell>

        <mxCell id="api_gw_rpc" value="Amazon API Gateway: POST /aws-blocks/api (ApiNamespace)&#xa;🚪 Type-Safe JSON-RPC Namespace&#xa;• chatWithAgent, listInventory, listDemands&#xa;• getParentActivity, toggleSandboxSession, seedSandbox&#xa;• resetSandbox, getSandboxStatus, confirmHandover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6D28D9;strokeColor=#A78BFA;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_security">
          <mxGeometry x="30" y="600" width="360" height="110" as="geometry" />
        </mxCell>

        <mxCell id="kms_cmk" value="AWS KMS Customer Managed Key (CMK)&#xa;🔐 alias/books-block-app-cmk&#xa;• Envelope Encryption for DynamoDB &amp; S3 at Rest&#xa;• Dedicated Key Policy &amp; CloudTrail Auditing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#64748B;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_security">
          <mxGeometry x="30" y="730" width="360" height="90" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- 3. STRANDS AGENT & AUTONOMOUS COMPUTE ENGINE                      -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <mxCell id="layer_agent" value="3. Strands Agents SDK &amp; Autonomous Compute Engine" style="swimlane;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#60A5FA;fontColor=#DBEAFE;fontStyle=1;rounded=1;arcSize=8;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="960" y="100" width="820" height="1480" as="geometry" />
