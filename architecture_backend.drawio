        <mxCell id="flow_8" value="8. Declarative Normalization &amp; Translation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#34D399;strokeWidth=2;fontColor=#34D399;" edge="1" parent="1" source="bedrock_multimodal" target="subject_catalog">
