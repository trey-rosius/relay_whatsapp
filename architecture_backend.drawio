        <mxCell id="t_search" value="🔍 searchInventory&#xa;Concept/Domain query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#38BDF8;fontColor=#FFFFFF;fontStyle=1;align=center;fontSize=11;" vertex="1" parent="tools_box">
