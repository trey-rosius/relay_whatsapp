        <!-- Pipeline Engines -->
        <mxCell id="bedrock_multimodal" value="Amazon Bedrock Multimodal &amp; Converse Engine&#xa;🧠 Text &amp; Image Feature Extraction (Claude 3.5/3.7 Sonnet)&#xa;• Multi-intent parsing (Offers + Requests in a single message)&#xa;• Automatic book condition grading (New, LikeNew, Good, Acceptable)&#xa;• School grade disambiguation &amp; conversational clarification prompts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4338CA;strokeColor=#818CF8;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_agent">
          <mxGeometry x="30" y="390" width="760" height="100" as="geometry" />
        </mxCell>

        <mxCell id="subject_catalog" value="Declarative SUBJECT_CATALOG Normalizer &amp; Translator&#xa;📖 4-Stage Declarative Regex Pipeline with Word Boundaries (\b)&#xa;• CamelCase splitting (Year5Chemistry ➔ Year 5 Chemistry) + Boilerplate stripping&#xa;• Canonical bilingual dictionary: Mathematics ⇄ Mathématiques, Biology ⇄ Biologie/SVT&#xa;• Single Source of Truth shared across cleanSubjectName and normalizeConceptKey" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#34D399;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_agent">
          <mxGeometry x="30" y="510" width="760" height="100" as="geometry" />
        </mxCell>

        <mxCell id="matchmaker_engine" value="Proactive Matchmaking &amp; 48H Reservation Lock&#xa;🎯 GSI byConcept Match Lookup + Autonomous Connection Intro&#xa;• Generates Cryptographic 4-Digit Handover Verification Code (#XXXX)&#xa;• Sets status: 'reserved' with reservedUntil = Date.now() + 48 Hours&#xa;• Introduces buyer &amp; seller via WhatsApp without exposing public phone numbers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#2DD4BF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_agent">
          <mxGeometry x="30" y="630" width="760" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cron_sweeper" value="AWS EventBridge Scheduler: holdExpiryCron&#xa;⏰ @aws-blocks/bb-cron-job running rate(15 minutes)&#xa;• Proactively sweeps DynamoDB for expired holds (reservedUntil &lt; now)&#xa;• Resets expired books to status: 'active' &amp; demands to status: 'pending'&#xa;• Emits HoldExpired lifecycle events and CloudWatch metric HoldExpiredCount" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C2410C;strokeColor=#FB923C;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_agent">
          <mxGeometry x="30" y="750" width="760" height="100" as="geometry" />
        </mxCell>

        <mxCell id="interactive_engine" value="Meta Interactive 2-Tier List &amp; 2-Button Card Engine&#xa;📱 WhatsApp UX Optimization with Strict Character Constraints&#xa;• Tier 1: Grade summary list (Année 1, Year 3, Year 5) with condition badges&#xa;• Tier 2: Subject drill-down list with strictly unique row IDs&#xa;• Safety confirmation: 2-button card ([ ✅ Confirm ] / [ ❌ Cancel ]) preventing accidental holds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#60A5FA;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_agent">
          <mxGeometry x="30" y="870" width="760" height="100" as="geometry" />
        </mxCell>

        <mxCell id="outbound_dispatcher" value="WhatsApp Outbound Dispatcher &amp; Rate Limiter&#xa;📤 sendWhatsAppTextMessage() &amp; sendWhatsAppInteractiveList()&#xa;• Meta Graph API v25.0 Dispatcher with Exponential Backoff&#xa;• Real-time EMF Delivery Latency Tracking &amp; Failure Recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#3B82F6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_agent">
          <mxGeometry x="30" y="990" width="760" height="90" as="geometry" />
        </mxCell>

        <mxCell id="durable_engine" value="AWS Lambda Durable Step Execution&#xa;⚙️ withDurableExecution(processWhatsAppInbound)&#xa;• Checkpointed Multi-Step Resilience &amp; S3 Image Processing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=#94A3B8;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="layer_agent">
          <mxGeometry x="30" y="1100" width="760" height="70" as="geometry" />
        </mxCell>

        <!-- ══════════════════════════════════════════════════════════════════ -->
